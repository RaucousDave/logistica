# Copy to .env and fill in real values. .env is gitignored; this file is not.
# Local dev uses logistica_tracking.settings.local (SQLite + in-memory) and
# needs none of these. The vars below are for production.

DJANGO_SETTINGS_MODULE=logistica_tracking.settings.production

# Django
SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=your-app.onrender.com
CORS_ALLOWED_ORIGINS=https://your-frontend-origin

# --- Database ---------------------------------------------------------
# Preferred: a single connection URL from Neon (Console -> Connect).
# production.py accepts NEON_DATABASE_URL or DATABASE_URL. Must be the
# pooled URL and include ?sslmode=require.
NEON_DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Fallback if you don't use a URL: discrete parts (URL takes precedence).
# DB_NAME=neondb
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=5432

# --- Redis (Channels layer + Celery broker) ---------------------------
REDIS_URL=redis://localhost:6379/0

# --- Domain tuning ----------------------------------------------------
ACCEPT_CONFLICT_WINDOW_SECONDS=1.0
LOCATION_DB_WRITE_INTERVAL_SECONDS=60
